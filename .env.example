# Copy to `.env` and adjust. All keys map to `Settings` in `backend/app/config.py`.
# Production-only template: `.env.prod.example` → copy to `.env.prod` (gitignored) for deploy secrets.
# Two environments: local (Docker / dev) and production (Render + Neon + Vercel).

# --- Required (API + Alembic) ---
# Local:
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research_swarm
# Production (Neon): paste the URI from Neon (direct or pooled). Plain `postgresql://` is OK — the API rewrites it for asyncpg.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# local | production — production defaults LLM to Gemini 2.5 Flash when MODEL_* are still the local Ollama defaults.
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production: add your Vercel origin, e.g. https://your-app.vercel.app

# --- Deploy: Render sets PORT; docker-entrypoint listens on PORT then API_PORT ---

# --- Compose: published web port (frontend/nginx) ---
WEB_PORT=3000

# --- LiteLLM: local (Ollama) ---
# OLLAMA_API_BASE=http://host.docker.internal:11434
MODEL_STRONG=ollama/llama3.2:3b
MODEL_FAST=ollama/llama3.2:1b

# --- LiteLLM: production (Gemini) ---
# GOOGLE_API_KEY=
# GEMINI_API_KEY=   # optional alias, same as GOOGLE_API_KEY
# MODEL_STRONG=gemini/gemini-2.5-flash
# MODEL_FAST=gemini/gemini-2.5-flash

# Other cloud APIs (OpenAI, etc.):
# LITELLM_API_KEY=

# Optional: Langfuse (https://langfuse.com) — keys must land in Settings / process env (restart API).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Match your project's region (examples): https://cloud.langfuse.com  or  https://us.cloud.langfuse.com  or  https://eu.cloud.langfuse.com  or  https://jp.cloud.langfuse.com
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_MOCK=false

LITELLM_NUM_RETRIES=3
LITELLM_REQUEST_TIMEOUT=900

SSE_POLL_INTERVAL_SECONDS=0.35
SSE_REPLAY_MAX_EVENTS=500

SIMILARITY_MODE=tfidf
EMBEDDING_MODEL=ollama/nomic-embed-text

# Optional search APIs (else DuckDuckGo, no key)
# TAVILY_API_KEY=
# SERPER_API_KEY=

SEARCH_ARCHIVE_SUPPLEMENT=true

EXTRACT_CLAIMS_TEMPERATURE=0.12
EXTRACT_CLAIMS_MAX_TOKENS=2240

MAX_PARALLEL_AGENT_CALLS=10
MAX_TOOL_CALLS_PER_AGENT_INVOCATION=8
MAX_CRITIC_ROUNDS=2
MAX_SUB_QUESTIONS_PER_WAVE=8
SESSION_COST_LIMIT_USD=0
CITATION_SIMILARITY_THRESHOLD=0.7

FETCH_MAX_BYTES=2000000
FETCH_TIMEOUT_SECONDS=30
USER_AGENT=DeepResearchSwarmBot/0.1 (+https://example.local; research)

# --- Frontend (Vite; set in Vercel Project → Environment Variables) ---
# VITE_API_BASE_URL=https://your-api.onrender.com
